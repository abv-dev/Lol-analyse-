# Clé Riot (Personal API Key — expire toutes les 24h, à régénérer sur developer.riotgames.com)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ATTENTION : si lol-live-coach tourne sur le même Hetzner avec la MÊME clé,
# les rate limits Riot sont partagés (par clé, par région). Le défaut réserve
# du budget sur europe pour le coach. Quand tu régénères la clé (expire /24h),
# mets à jour les DEUX .env : celui-ci ET celui de lol-live-coach.

# Optionnel (valeurs par défaut ci-dessous)
#DB_PATH=data/matches.db
# Budget requêtes par région "req_par_s,req_par_2min".
# Défauts : asia/americas 18,84 (~42 req/min) ; europe 14,68 (~34 req/min,
# budget réservé pour lol-live-coach sur la même clé).
#RATE_LIMIT_EUROPE=14,68
#RATE_LIMIT_ASIA=18,84
#RATE_LIMIT_AMERICAS=18,84
# LOG_LEVEL=DEBUG pour tracer chaque acquire du rate limiter
#LOG_LEVEL=INFO

# --- milestone_check.py (jalons Todoist, lancé par cron) ---
# Token API Todoist (Paramètres > Intégrations > Développeur)
#TODOIST_API_TOKEN=xxxxxxxx
# Seuils de matchs sur le patch courant qui déclenchent une tâche
#MILESTONES=50000,100000,250000,500000
# Projet Todoist cible, résolu par son nom
#TODOIST_PROJECT_NAME=LoL Studies
#LOG_DIR=logs
#MATCHES_PER_PLAYER=20
# Fenêtre glissante de collecte (jours) : seuls les matchs plus récents sont
# demandés (filtre startTime côté Riot). Exclut les vieux patchs des joueurs
# inactifs sans dépenser de budget.
#MATCH_MAX_AGE_DAYS=28
# Fraction des matchs dont la timeline est collectée (tirage déterministe sur
# le match_id). Chaque timeline coûte 1 requête ET ~27 Ko de base : à 0.33,
# compter ~6,7 Go pour un patch de 786k matchs. 0 pour désactiver.
#TIMELINE_SAMPLE_RATE=0.33
#MAX_PAGES_PER_DIVISION=30
#PATCH_CHECK_INTERVAL=21600

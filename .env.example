# Clé Riot (Personal API Key — expire toutes les 24h, à régénérer sur developer.riotgames.com)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ATTENTION : si lol-live-coach tourne sur le même Hetzner avec la MÊME clé,
# les rate limits Riot sont partagés (par clé, par région). Le défaut réserve
# du budget sur europe pour le coach. Quand tu régénères la clé (expire /24h),
# mets à jour les DEUX .env : celui-ci ET celui de lol-live-coach.

# Optionnel (valeurs par défaut ci-dessous)
#DB_PATH=data/matches.db
# Budget requêtes par région "req_par_s,req_par_2min" (défauts : europe 14,72
# — marge coach — ; asia et americas 18,90)
#RATE_LIMIT_EUROPE=14,72
#RATE_LIMIT_ASIA=18,90
#RATE_LIMIT_AMERICAS=18,90
#LOG_DIR=logs
#MATCHES_PER_PLAYER=20
#MAX_PAGES_PER_DIVISION=30
#PATCH_CHECK_INTERVAL=21600
